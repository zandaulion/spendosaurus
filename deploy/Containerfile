FROM docker.io/library/node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY web ./web

# Create appuser with non-root UID
RUN addgroup -g 10006 appgroup && \
    adduser -u 10006 -G appgroup -s /bin/sh -D appuser && \
    mkdir -p /data && chown -R 10006:10006 /data /app

VOLUME /data
ENV DATA_DIR=/data
ENV PORT=3090

USER 10006
EXPOSE 3090

CMD ["node", "server/index.js"]
